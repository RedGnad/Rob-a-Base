{
  "name": "dcl-project",
  "version": "1.0.0",
  "description": "SDK7 Template scene",
  "scripts": {
    "start": "sdk-commands start",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@latest",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "server-logs": "sdk-commands sdk-server-logs",
    "duo": "bash tools/duo.sh",
    "duo:reset": "bash tools/duo.sh --reset",
    "build:prod": "sdk-commands build --production",
    "postinstall": "node tools/patch-linker.js"
  },
  "devDependencies": {
    "@dcl/js-runtime": "7.26.1-32239895147.commit-3c77d90",
    "@dcl/sdk": "^7.26.1-32239895147.commit-3c77d90"
  },
  "engines": {
    "node": ">=22"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  }
}
